---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import { t } from '../lib/texte';
import { type Lang, alternates, route, cvPdfPfad } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tx = t(lang);
const s = tx.skills;
---
<Base
  lang={lang}
  titel={s.seo_titel}
  beschreibung={s.seo_beschreibung}
  alternates={alternates('skills')}
  aktiv="skills"
  ogBild={`/og/${lang}/skills.png`}
>
  <PageHero eyebrow={s.eyebrow} titel={s.titel} intro={s.intro}>
    <div class="legend" aria-label={s.legende_titel}>
      {
        s.stufen.map((label, i) => (
          <span class="legend-item">
            <span class="dots" data-level={i} aria-hidden="true">
              <i />
              <i />
              <i />
            </span>
            {label}
          </span>
        ))
      }
    </div>
  </PageHero>

  <section class="container groups" aria-label={s.eyebrow}>
    {
      s.gruppen.map((g) => (
        <article class="card card--pad group reveal">
          <header class="group-head">
            <span class="icon-tile">
              <Icon name={g.icon} size={22} />
            </span>
            <h2 class="h3">{g.titel}</h2>
          </header>
          <ul class="skills" role="list">
            {g.eintraege.map((e) => (
              <li class="skill" data-level={e.stufe}>
                <div class="skill-top">
                  <span class="skill-name">{e.name}</span>
                  <span class="skill-level">
                    <span class="dots" data-level={e.stufe} aria-hidden="true">
                      <i />
                      <i />
                      <i />
                    </span>
                    <span class="level-label">{s.stufen[e.stufe]}</span>
                  </span>
                </div>
                <p>{e.text}</p>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>

  <section class="container section two" aria-labelledby="zert-titel">
    <div>
      <SectionHead eyebrow={s.zertifikate_titel} titel={s.zertifikate_titel} id="zert-titel" class="compact" />
      <ul class="certs" role="list">
        {
          s.zertifikate.map((z) => (
            <li class="card card--pad cert reveal">
              <span class="icon-tile icon-tile--accent">
                <Icon name={z.icon} size={22} />
              </span>
              <div>
                <h3 class="h3">{z.name}</h3>
                <p class="issuer">{z.aussteller}</p>
                <p class="muted">{z.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <SectionHead eyebrow={s.soft_titel} titel={s.soft_titel} class="compact" />
      <ul class="soft" role="list">
        {
          s.soft.map((x) => (
            <li class="soft-item reveal">
              <Icon name="check" size={16} />
              {x}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="container section" aria-labelledby="lernen-titel">
    <SectionHead eyebrow={s.lernen.eyebrow} titel={s.lernen.titel} intro={s.lernen.intro} id="lernen-titel" />
    <ol class="steps" role="list">
      {
        s.lernen.schritte.map((st, i) => (
          <li class="card card--pad step reveal">
            <span class="step-no">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h3">{st.titel}</h3>
            <p class="muted">{st.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container section" aria-labelledby="roadmap-titel">
    <SectionHead eyebrow={s.roadmap.eyebrow} titel={s.roadmap.titel} id="roadmap-titel" />
    <ol class="road" role="list">
      {
        s.roadmap.schritte.map((r, i) => (
          <li class:list={['road-step reveal', { current: i === 0 }]}>
            <span class="road-dot" aria-hidden="true" />
            <span class="road-time">{r.zeit}</span>
            <h3 class="h3">{r.titel}</h3>
            <p class="muted">{r.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container section two" aria-labelledby="setup-titel">
    <div>
      <SectionHead eyebrow={s.setup.eyebrow} titel={s.setup.titel} id="setup-titel" class="compact" />
      <dl class="setup card">
        {
          s.setup.liste.map((x) => (
            <div class="setup-row">
              <dt>{x.kategorie}</dt>
              <dd>{x.name}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="card cv reveal" id="lebenslauf">
      <span class="icon-tile">
        <Icon name="file-text" size={24} />
      </span>
      <h2 class="h3">{s.lebenslauf.titel}</h2>
      <p class="muted">{s.lebenslauf.text}</p>
      <div class="cv-actions">
        <a class="btn btn--primary" href={cvPdfPfad(lang)} download>
          <Icon name="download" size={18} />
          {s.lebenslauf.pdf}
        </a>
        <a class="btn btn--secondary" href={route('lebenslauf', lang)}>
          {s.lebenslauf.ansehen}
          <Icon name="arrow-right" size={17} class="arrow" />
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface-1);
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }
  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .dots {
    display: inline-flex;
    gap: 3px;
  }
  .dots i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--surface-3);
  }
  .dots[data-level='0'] i {
    background: transparent;
    box-shadow: 0 0 0 1px var(--border-strong) inset;
  }
  .dots[data-level='1'] i:nth-child(-n + 1),
  .dots[data-level='2'] i:nth-child(-n + 2),
  .dots[data-level='3'] i {
    background: var(--primary);
    box-shadow: 0 0 8px rgb(59 130 246 / 0.5);
  }

  .groups {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr));
    align-items: start;
  }
  .group-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .skills {
    display: grid;
    gap: var(--space-4);
  }
  .skill {
    display: grid;
    gap: 0.2rem;
    padding-bottom: var(--space-4);
    border-bottom: 1px dashed var(--border);
  }
  .skill:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .skill-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }
  .skill-name {
    font-weight: 650;
  }
  .skill-level {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-xs);
    color: var(--text-subtle);
    white-space: nowrap;
  }
  .skill[data-level='0'] .skill-name {
    color: var(--text-muted);
  }
  .skill[data-level='0'] .level-label {
    color: var(--accent-text);
  }
  .skill p {
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .two {
    display: grid;
    gap: var(--space-8);
  }
  @media (min-width: 900px) {
    .two {
      grid-template-columns: 1.3fr 1fr;
      gap: var(--space-7);
    }
  }
  :global(.compact) {
    margin-bottom: var(--space-5);
  }
  :global(.compact) :global(.h2) {
    font-size: var(--fs-h3);
  }
  .certs {
    display: grid;
    gap: var(--space-3);
  }
  .cert {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }
  .issuer {
    font-size: var(--fs-sm);
    color: var(--accent-text);
    font-weight: 600;
    margin: 0.15rem 0 0.4rem;
  }
  .soft {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
  }
  .soft-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface-1);
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .soft-item :global(svg) {
    color: var(--success);
    flex: none;
  }

  .steps {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    counter-reset: step;
  }
  .step {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }
  .step-no {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--primary-text);
    margin-bottom: var(--space-2);
  }

  .road {
    position: relative;
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 760px) {
    .road {
      grid-template-columns: repeat(3, 1fr);
    }
    .road::before {
      content: '';
      position: absolute;
      top: 0.55rem;
      left: 0.6rem;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, var(--success), var(--primary) 40%, var(--accent));
      opacity: 0.6;
    }
  }
  .road-step {
    position: relative;
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    padding-left: 2rem;
  }
  @media (min-width: 760px) {
    .road-step {
      padding-left: 0;
      padding-top: 2.25rem;
    }
  }
  .road-dot {
    position: absolute;
    left: 0;
    top: 0.1rem;
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--primary);
  }
  .current .road-dot {
    border-color: var(--success);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--success) 15%, transparent);
  }
  .road-step:last-child .road-dot {
    border-color: var(--accent);
  }
  .road-time {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--primary-text);
  }
  .current .road-time {
    color: var(--success);
  }

  .setup {
    padding: var(--space-2) var(--space-5);
  }
  .setup-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px dashed var(--border);
  }
  .setup-row:last-child {
    border-bottom: 0;
  }
  .setup-row dt {
    color: var(--text-subtle);
  }
  .setup-row dd {
    font-weight: 600;
    text-align: right;
  }
  .cv {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    align-content: start;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(80% 100% at 100% 0%, var(--primary-soft), transparent 70%),
      var(--glass);
  }
  .cv-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
</style>
