---
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import { t } from '../../lib/texte';
import type { Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}
const tx = t(Astro.props.lang).start;
const f = tx.freizeit;
const sp = tx.sprachen;
const [haupt, ...rest] = f.liste;
---
<section class="container section" aria-labelledby="freizeit-titel">
  <SectionHead eyebrow={f.eyebrow} titel={f.titel} intro={f.intro} id="freizeit-titel" />
  <div class="bento">
    <article class="card tile tile--main reveal">
      <div class="main-bg" aria-hidden="true">
        <span>13</span>
      </div>
      <span class="icon-tile icon-tile--accent big"><Icon name={haupt.icon} size={30} /></span>
      <h3 class="h2">{haupt.titel}</h3>
      <p>{haupt.text}</p>
      {
        haupt.highlight && (
          <p class="chip chip--accent goal">
            <Icon name="trophy" size={14} />
            {haupt.highlight}
          </p>
        )
      }
    </article>
    {
      rest.map((item) => (
        <article class="card tile reveal">
          <span class="icon-tile">
            <Icon name={item.icon} size={22} />
          </span>
          <div>
            <h3 class="h3">{item.titel}</h3>
            <p>{item.text}</p>
          </div>
        </article>
      ))
    }
    <article class="card tile tile--lang reveal" aria-labelledby="sprachen-titel">
      <div class="lang-head">
        <p class="eyebrow">{sp.eyebrow}</p>
        <h3 id="sprachen-titel" class="h3">{sp.titel}</h3>
      </div>
      <ul class="langs" role="list">
        {
          sp.liste.map((l) => (
            <li class="lang">
              <span class="lang-name">{l.sprache}</span>
              <span class="lang-level">{l.niveau}</span>
              <span class="meter" role="img" aria-label={`${l.stufe}/5`}>
                {Array.from({ length: 5 }, (_, i) => (
                  <i class:list={{ on: i < l.stufe }} />
                ))}
              </span>
            </li>
          ))
        }
      </ul>
    </article>
  </div>
</section>

<style>
  .bento {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 720px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tile--main {
      grid-column: 1 / -1;
    }
    .tile--lang {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1024px) {
    .bento {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-rows: minmax(0, auto);
    }
    .tile--main {
      grid-column: span 2;
      grid-row: span 3;
    }
    .tile--lang {
      grid-column: 1 / -1;
    }
  }
  .tile {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
  }
  .tile p {
    color: var(--text-muted);
    font-size: 0.9375rem;
    margin-top: var(--space-1);
  }
  .tile--main {
    position: relative;
    overflow: hidden;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-3);
    min-height: 20rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    background:
      radial-gradient(70% 90% at 100% 0%, var(--accent-soft), transparent 70%),
      var(--glass);
  }
  .tile--main p {
    font-size: var(--fs-lead);
    max-width: 36ch;
  }
  .tile--main .h2 {
    font-size: clamp(2rem, 1.6rem + 2vw, 3rem);
    font-weight: 800;
  }
  .big {
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 1.1rem;
    margin-bottom: auto;
  }
  .main-bg {
    position: absolute;
    right: -0.5rem;
    top: -2.5rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(10rem, 8rem + 10vw, 17rem);
    line-height: 1;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--accent-line);
    pointer-events: none;
    user-select: none;
  }
  .goal {
    margin-top: var(--space-2);
  }
  .tile--lang {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 860px) {
    .tile--lang {
      grid-template-columns: 0.7fr 2fr;
      align-items: center;
    }
  }
  .lang-head {
    display: grid;
    gap: var(--space-2);
  }
  .langs {
    display: grid;
    gap: var(--space-3) var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  .lang {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.15rem 1rem;
    align-items: center;
    padding: 0.6rem 0;
    border-bottom: 1px dashed var(--border);
  }
  .lang-name {
    font-weight: 650;
  }
  .lang-level {
    grid-row: 2;
    font-size: var(--fs-xs);
    color: var(--text-subtle);
  }
  .meter {
    grid-row: 1 / span 2;
    grid-column: 2;
    display: flex;
    gap: 3px;
  }
  .meter i {
    width: 0.9rem;
    height: 0.4rem;
    border-radius: 2px;
    background: var(--surface-3);
  }
  .meter i.on {
    background: var(--gradient-brand);
    background-size: 500% 100%;
  }
</style>
