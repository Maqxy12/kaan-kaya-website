---
import Icon from '../Icon.astro';
import { t } from '../../lib/texte';
import type { Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}
const m = t(Astro.props.lang).start.motto;
---
<section class="container section" aria-labelledby="motto-titel">
  <figure class="card motto reveal">
    <span class="icon-tile icon-tile--accent sun" aria-hidden="true"><Icon name="sunrise" size={24} /></span>
    <p id="motto-titel" class="eyebrow">{m.eyebrow}</p>
    <blockquote>
      <p>{m.zitat}</p>
    </blockquote>
  </figure>
</section>

<style>
  .motto {
    position: relative;
    overflow: hidden;
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    margin: 0;
    padding: clamp(2.25rem, 1.5rem + 3vw, 4.5rem) clamp(1.25rem, 1rem + 3vw, 5rem);
    border-radius: var(--radius-xl);
    text-align: center;
    background:
      radial-gradient(60% 80% at 50% 0%, var(--accent-soft), transparent 70%),
      radial-gradient(50% 70% at 50% 100%, var(--primary-soft), transparent 70%),
      var(--glass);
  }
  .motto::before {
    content: '“';
    position: absolute;
    top: -2.5rem;
    left: 50%;
    translate: -50% 0;
    font-family: var(--font-display);
    font-size: 16rem;
    line-height: 1;
    color: var(--accent-line);
    opacity: 0.35;
    pointer-events: none;
  }
  .sun {
    position: relative;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 1rem;
  }
  .eyebrow {
    position: relative;
  }
  blockquote {
    position: relative;
    margin: 0;
    max-width: 46rem;
  }
  blockquote p {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.1rem + 1.5vw, 2.25rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  blockquote p::before {
    content: '„';
  }
  blockquote p::after {
    content: '“';
  }
  :global(html[lang='en']) blockquote p::before {
    content: '“';
  }
  :global(html[lang='en']) blockquote p::after {
    content: '”';
  }
</style>
