---
import Icon from '../Icon.astro';
import Avatar from '../Avatar.astro';
import { t, profil } from '../../lib/texte';
import { type Lang, route } from '../../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tx = t(lang);
const s = tx.start;
---
<section class="hero container" aria-labelledby="hero-titel">
  <div class="hero-copy hero-in">
    <p class="badge">
      <span class="pulse-dot" aria-hidden="true"></span>
      {s.badge}
    </p>
    <h1 id="hero-titel" class="h-display">
      <span class="name">{profil.name}</span>
      <span class="line">{s.titel}</span>
      <span class="line text-gradient">{s.titel_akzent}</span>
    </h1>
    <p class="lead">{s.intro}</p>
    <div class="ctas">
      <a class="btn btn--primary" href={route('projekte', lang)}>
        {s.cta_projekte}
        <Icon name="arrow-right" size={18} class="arrow" />
      </a>
      <a class="btn btn--secondary" href={route('kontakt', lang)}>
        <Icon name="send" size={17} />
        {s.cta_kontakt}
      </a>
    </div>
  </div>

  <aside class="card tape" aria-label={s.karte.titel}>
    <div class="tape-head">
      <span class="tape-title">{s.karte.titel}</span>
      <span class="tape-sub">{s.karte.untertitel}</span>
    </div>
    <div class="tape-photo">
      <Avatar alt={s.karte.foto_alt} size={360} eager />
      <div class="tape-name">
        <strong>{profil.name}</strong>
        <span>{tx.meta.rolle}</span>
      </div>
    </div>
    <dl class="tape-list">
      {
        s.karte.felder.map((f) => (
          <div class="tape-row">
            <dt>{f.label}</dt>
            <dd>{f.wert}</dd>
          </div>
        ))
      }
    </dl>
  </aside>

  <ul class="facts" role="list">
    {
      s.fakten.map((f) => (
        <li class="fact">
          <span class="fact-value">{f.wert}</span>
          <span class="fact-label">{f.label}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
    padding-top: clamp(2.5rem, 1.5rem + 5vw, 6rem);
    padding-bottom: calc(var(--section-gap) / 2);
    grid-template-columns: minmax(0, 1fr);
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: -4rem calc(var(--gutter) * -1) 0;
    z-index: -1;
    background-image: radial-gradient(var(--grid-dot) 1px, transparent 1.2px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 70% 60% at 30% 35%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 30% 35%, #000 20%, transparent 75%);
    pointer-events: none;
  }
  @media (min-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr);
      align-items: center;
      column-gap: clamp(3rem, 5vw, 5rem);
    }
    .facts {
      grid-column: 1 / -1;
    }
  }

  .hero-copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.9rem 0.4rem 0.75rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--accent-line);
    background: var(--accent-soft);
    color: var(--accent-text);
    font-size: var(--fs-sm);
    font-weight: 600;
  }
  h1 {
    display: grid;
    gap: 0.1em;
  }
  .name {
    font-size: var(--fs-sm);
    font-family: var(--font-sans);
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-subtle);
    margin-bottom: 0.6rem;
  }
  .line {
    display: block;
  }
  .lead {
    max-width: 38rem;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
  @media (max-width: 479px) {
    .ctas {
      width: 100%;
      display: grid;
    }
  }

  /* ── Steckbrief-Karte ── */
  @property --angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }
  .tape {
    padding: 1.25rem;
    display: grid;
    gap: 1.1rem;
    border-radius: var(--radius-xl);
    isolation: isolate;
    max-width: 30rem;
    width: 100%;
    justify-self: center;
  }
  .tape::before {
    content: '';
    position: absolute;
    inset: -1px;
    z-index: -1;
    border-radius: inherit;
    padding: 1px;
    background: conic-gradient(from var(--angle), transparent 0 55%, #3b82f6 70%, #f97316 85%, transparent 95%);
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    -webkit-mask-composite: xor;
    animation: spin 7s linear infinite;
  }
  .tape::after {
    content: '';
    position: absolute;
    inset: 12% -10% auto;
    height: 60%;
    z-index: -2;
    background: radial-gradient(closest-side, rgb(59 130 246 / 0.28), transparent);
    filter: blur(30px);
  }
  @keyframes spin {
    to {
      --angle: 360deg;
    }
  }
  .tape-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-size: var(--fs-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
  }
  .tape-title {
    color: var(--text);
  }
  .tape-sub {
    color: var(--accent-text);
  }
  .tape-photo {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
  }
  /* Monogramm im Querformat, echtes Foto quadratisch (sonst verdeckt der Name das Gesicht) */
  .tape-photo :global(svg.avatar) {
    aspect-ratio: 5 / 4;
  }
  .tape-photo :global(img.avatar) {
    display: block;
    background: #f4f4f5;
  }
  .tape-name {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    padding: 2.5rem 1rem 0.9rem;
    background: linear-gradient(to top, rgb(5 8 14 / 0.9), transparent);
    color: #f1f5f9;
  }
  .tape-name strong {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .tape-name span {
    font-size: var(--fs-xs);
    color: #b6c2d4;
  }
  .tape-list {
    display: grid;
  }
  .tape-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.55rem 0.25rem;
    border-bottom: 1px dashed var(--border);
    font-size: var(--fs-sm);
  }
  .tape-row:last-child {
    border-bottom: 0;
  }
  .tape-row dt {
    color: var(--text-subtle);
    flex: none;
  }
  .tape-row dd {
    margin-left: auto;
    text-align: right;
    font-weight: 600;
    color: var(--text);
  }

  /* ── Kennzahlen ── */
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    overflow: hidden;
  }
  @media (min-width: 720px) {
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .fact {
    display: grid;
    gap: 0.35rem;
    align-content: start;
    padding: clamp(1rem, 0.8rem + 1vw, 1.6rem);
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .fact:nth-child(2n) {
    border-right: 0;
  }
  .fact:nth-last-child(-n + 2) {
    border-bottom: 0;
  }
  @media (min-width: 720px) {
    .fact {
      border-bottom: 0;
    }
    .fact:nth-child(2n) {
      border-right: 1px solid var(--border);
    }
    .fact:last-child {
      border-right: 0;
    }
  }
  .fact-value {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 1.5rem + 1.6vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
    background: var(--gradient-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .fact-label {
    font-size: var(--fs-xs);
    color: var(--text-subtle);
    font-weight: 550;
    line-height: 1.4;
  }
</style>
