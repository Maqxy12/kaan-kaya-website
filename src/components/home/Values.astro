---
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import { t } from '../../lib/texte';
import type { Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}
const w = t(Astro.props.lang).start.werte;
---
<section class="container section" aria-labelledby="werte-titel">
  <SectionHead eyebrow={w.eyebrow} titel={w.titel} intro={w.intro} id="werte-titel" />
  <ul class="values" role="list">
    {
      w.liste.map((v, i) => (
        <li class="card card--pad card--interactive value reveal">
          <span class:list={['icon-tile', { 'icon-tile--accent': i === w.liste.length - 1 }]}>
            <Icon name={v.icon} size={22} />
          </span>
          <h3 class="h3">{v.titel}</h3>
          <p class="muted">{v.text}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .values {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .value {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }
  .value .h3 {
    margin-top: var(--space-2);
  }
  .value p {
    font-size: 0.9375rem;
  }
</style>
