---
/** Monogramm-Logo: Hexagon (aus der Brand Mark) mit stilisiertem K und Amber-Punkt. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
const id = `lg-${Math.random().toString(36).slice(2, 8)}`;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 32 32"
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={id} x1="4" y1="4" x2="28" y2="28" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#60a5fa" />
      <stop offset="0.55" stop-color="#3b82f6" />
      <stop offset="1" stop-color="#f97316" />
    </linearGradient>
  </defs>
  <path
    d="M16 2.6 27.6 9.3v13.4L16 29.4 4.4 22.7V9.3z"
    fill="none"
    stroke={`url(#${id})`}
    stroke-width="2.2"
    stroke-linejoin="round"
  />
  <path
    d="M12.4 10v12M20 10l-6.2 6 6.6 6"
    fill="none"
    stroke="currentColor"
    stroke-width="2.4"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <circle cx="21.2" cy="16" r="1.9" fill="#f97316" />
</svg>
