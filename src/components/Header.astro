---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { t, profil, instagramUrl } from '../lib/texte';
import { type Lang, type Alternates, route, andereSprache } from '../lib/i18n';
import type { NavKey } from '../layouts/Base.astro';

interface Props {
  lang: Lang;
  aktiv: NavKey;
  alternates: Alternates;
}
const { lang, aktiv, alternates } = Astro.props;
const tx = t(lang);
const other = andereSprache(lang);

const links = [
  { key: 'start', label: tx.nav.start },
  { key: 'projekte', label: tx.nav.projekte },
  { key: 'skills', label: tx.nav.skills },
  { key: 'blog', label: tx.nav.blog },
  { key: 'jetzt', label: tx.nav.jetzt },
  { key: 'kontakt', label: tx.nav.kontakt },
] as const;

const drawerLinks = [
  { key: 'start', label: tx.nav.start, icon: 'user' },
  { key: 'projekte', label: tx.nav.projekte, icon: 'folder-code' },
  { key: 'skills', label: tx.nav.skills, icon: 'layers' },
  { key: 'blog', label: tx.nav.blog, icon: 'pen-line' },
  { key: 'jetzt', label: tx.nav.jetzt, icon: 'sparkles' },
  { key: 'lebenslauf', label: tx.nav.lebenslauf, icon: 'file-text' },
  { key: 'kontakt', label: tx.nav.kontakt, icon: 'at-sign' },
] as const;
---
<header class="site-header vt-header">
  <div class="container header-inner">
    <a class="brand" href={route('start', lang)} aria-label={`${profil.name} – ${tx.nav.start}`}>
      <Logo size={30} class="brand-logo" />
      <span class="brand-name">{profil.name}</span>
    </a>

    <nav class="nav-desktop" aria-label={tx.nav.hauptnavigation}>
      <ul role="list">
        {
          links.map((l) => (
            <li>
              <a href={route(l.key, lang)} aria-current={aktiv === l.key ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <a class="status" href={route('kontakt', lang)} data-status title={tx.status.ortszeit}>
        <span class="pulse-dot" aria-hidden="true"></span>
        <span class="status-city">{profil.stadt}</span>
        <time class="status-time" data-clock></time>
      </a>
      <button class="search-btn" type="button" data-palette-open aria-label={tx.nav.suche} title={tx.nav.suche_lang} aria-keyshortcuts="Control+K Meta+K">
        <Icon name="search" size={17} />
        <span class="search-label">{tx.nav.suche}</span>
        <span class="search-kbd" aria-hidden="true"><kbd data-mod>⌘</kbd><kbd>K</kbd></span>
      </button>
      <a
        class="icon-btn lang-btn"
        href={alternates[other]}
        hreflang={other === 'de' ? 'de-CH' : 'en'}
        lang={other === 'de' ? 'de-CH' : 'en'}
        aria-label={tx.nav.sprache_wechseln}
        data-lang-switch
      >
        {other.toUpperCase()}
      </a>
      <button class="icon-btn theme-btn" type="button" data-theme-toggle aria-label={tx.nav.theme_wechseln}>
        <Icon name="sun" size={19} class="i-sun" />
        <Icon name="moon" size={19} class="i-moon" />
      </button>
      <button class="icon-btn menu-btn" type="button" popovertarget="menu" aria-label={tx.nav.menue}>
        <Icon name="menu" size={21} />
      </button>
    </div>
  </div>
</header>

<div id="menu" popover class="drawer" aria-label={tx.nav.menue_titel}>
  <div class="drawer-head">
    <span class="drawer-title">{tx.nav.menue_titel}</span>
    <button class="icon-btn" type="button" popovertarget="menu" popovertargetaction="hide" aria-label={tx.nav.menue_schliessen}>
      <Icon name="x" size={21} />
    </button>
  </div>
  <nav aria-label={tx.nav.menue_titel}>
    <ul role="list" class="drawer-list">
      {
        drawerLinks.map((l) => (
          <li>
            <a href={route(l.key, lang)} aria-current={aktiv === l.key ? 'page' : undefined}>
              <Icon name={l.icon} size={19} />
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="drawer-foot">
    <a class="btn btn--secondary btn--sm" href={`mailto:${profil.email}`}>
      <Icon name="mail" size={16} />{tx.allgemein.e_mail}
    </a>
    {
      instagramUrl && (
        <a class="btn btn--secondary btn--sm" href={instagramUrl} rel="me noopener" target="_blank">
          <Icon name="instagram" size={16} />Instagram
        </a>
      )
    }
    <a class="drawer-small" href={route('datenschutz', lang)}>{tx.nav.datenschutz}</a>
  </div>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: saturate(160%) blur(18px);
    -webkit-backdrop-filter: saturate(160%) blur(18px);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
  }
  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 750;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
    border-radius: var(--radius-sm);
    flex: none;
  }
  .brand :global(.brand-logo) {
    transition: transform var(--dur-slow) var(--ease-spring);
  }
  .brand:hover :global(.brand-logo) {
    transform: rotate(60deg);
  }
  .brand-name {
    display: none;
  }
  @media (min-width: 400px) {
    .brand-name {
      display: inline;
    }
  }

  .nav-desktop {
    display: none;
    margin-inline: auto;
  }
  .nav-desktop ul {
    display: flex;
    gap: 0.125rem;
    padding: 0.25rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface-1) 60%, transparent);
  }
  .nav-desktop a {
    display: block;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: var(--fs-sm);
    font-weight: 550;
    color: var(--text-muted);
    transition:
      color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out);
  }
  .nav-desktop a:hover {
    color: var(--text);
  }
  .nav-desktop a[aria-current='page'] {
    color: var(--text);
    background: var(--surface-3);
    box-shadow: 0 1px 0 var(--rim) inset;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 2rem;
    padding: 0 0.75rem;
    margin-right: 0.25rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border);
    background: var(--surface-1);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .status .pulse-dot {
    color: var(--text-subtle);
  }
  .status .pulse-dot::after {
    display: none;
  }
  .status[data-available='true'] .pulse-dot {
    color: var(--success);
  }
  .status[data-available='true'] .pulse-dot::after {
    display: block;
  }
  .status-time:empty {
    display: none;
  }
  @media (max-width: 359px) {
    .status {
      display: none;
    }
  }

  .search-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.75rem;
    min-width: 2.75rem;
    justify-content: center;
    border-radius: var(--radius-full);
    color: var(--text-muted);
    transition:
      background-color var(--dur),
      color var(--dur),
      border-color var(--dur);
  }
  .search-btn:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .search-label,
  .search-kbd {
    display: none;
  }
  .search-kbd {
    gap: 0.2rem;
  }
  .search-kbd kbd {
    height: 1.25rem;
    min-width: 1.25rem;
    font-size: 0.6875rem;
  }

  .lang-btn {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .theme-btn :global(.i-moon) {
    display: none;
  }
  :global([data-theme='light']) .theme-btn :global(.i-sun) {
    display: none;
  }
  :global([data-theme='light']) .theme-btn :global(.i-moon) {
    display: block;
  }

  @media (min-width: 860px) {
    .nav-desktop {
      display: block;
    }
    .menu-btn {
      display: none;
    }
    .brand {
      min-width: 9.5rem;
    }
  }
  @media (min-width: 1100px) {
    .search-btn {
      padding: 0 0.5rem 0 0.9rem;
      height: 2.25rem;
      border: 1px solid var(--border);
      background: var(--surface-1);
      margin-inline: 0.25rem;
    }
    .search-btn:hover {
      border-color: var(--border-strong);
    }
    .search-label {
      display: inline;
      font-size: var(--fs-sm);
      margin-right: 1.25rem;
    }
    .search-kbd {
      display: inline-flex;
    }
  }

  /* ── Menü (Popover, funktioniert ohne JavaScript) ── */
  .drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(22rem, 88vw);
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: var(--space-4) var(--space-5) calc(var(--space-6) + env(safe-area-inset-bottom));
    border: 0;
    border-left: 1px solid var(--border);
    background: var(--glass-strong);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    color: var(--text);
    display: none;
    flex-direction: column;
    gap: var(--space-5);
    overflow-y: auto;
    transition:
      transform 320ms var(--ease-out),
      opacity 320ms var(--ease-out),
      display 320ms allow-discrete,
      overlay 320ms allow-discrete;
    transform: translateX(100%);
    opacity: 0;
  }
  .drawer:popover-open {
    display: flex;
    transform: none;
    opacity: 1;
  }
  @starting-style {
    .drawer:popover-open {
      transform: translateX(100%);
      opacity: 0;
    }
  }
  .drawer::backdrop {
    background: rgb(2 6 12 / 0.55);
    backdrop-filter: blur(2px);
  }
  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .drawer-title {
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 650;
    color: var(--text-subtle);
  }
  .drawer-list {
    display: grid;
    gap: 0.25rem;
  }
  .drawer-list a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.8rem 0.9rem;
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.125rem;
    color: var(--text-muted);
    transition:
      background-color var(--dur),
      color var(--dur);
  }
  .drawer-list a:hover {
    background: var(--surface-2);
    color: var(--text);
  }
  .drawer-list a[aria-current='page'] {
    color: var(--text);
    background: var(--primary-soft);
  }
  .drawer-list a[aria-current='page'] :global(svg) {
    color: var(--primary-text);
  }
  .drawer-foot {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }
  .drawer-small {
    width: 100%;
    margin-top: var(--space-3);
    font-size: var(--fs-sm);
    color: var(--text-subtle);
  }
</style>
