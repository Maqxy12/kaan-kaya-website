---
/**
 * Icon aus dem Lucide-Set (https://lucide.dev/icons) – wird beim Bauen als SVG eingefügt.
 * Beispiel: <Icon name="mail" size={20} />
 */
import lucide from '@iconify-json/lucide/icons.json';

interface Props {
  name: string;
  size?: number;
  class?: string;
  label?: string;
  strokeWidth?: number;
}
const { name, size = 20, class: className, label, strokeWidth } = Astro.props;
type IconSet = { icons: Record<string, { body: string }>; aliases?: Record<string, { parent: string }> };
const set = lucide as unknown as IconSet;
const icon = set.icons[name] ?? set.icons[set.aliases?.[name]?.parent ?? ''];
if (!icon) throw new Error(`Icon "${name}" gibt es nicht. Namen findest du auf https://lucide.dev/icons`);
const body = strokeWidth ? icon.body.replaceAll('stroke-width="2"', `stroke-width="${strokeWidth}"`) : icon.body;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={body}
/>
