---
/**
 * Profilbild. Liegt ein Foto unter src/assets/profil.jpg (oder .png/.webp),
 * wird es automatisch optimiert (AVIF/WebP) angezeigt – sonst das Monogramm.
 */
import { Picture } from 'astro:assets';
import { profil } from '../lib/texte';
import { foto } from '../lib/foto';

interface Props {
  alt: string;
  size?: number;
  class?: string;
  eager?: boolean;
}
const { alt, size = 320, class: className, eager = false } = Astro.props;
---
{
  foto ? (
    <Picture
      src={foto}
      alt={alt}
      width={size}
      height={size}
      formats={['avif', 'webp']}
      class:list={['avatar', className]}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      densities={[1, 2]}
    />
  ) : (
    <svg class:list={["avatar", "avatar--mono", className]} viewBox="0 0 200 200" preserveAspectRatio="xMidYMid slice" role={alt ? 'img' : undefined} aria-label={alt || undefined} aria-hidden={alt ? undefined : 'true'}>
      <defs>
        <linearGradient id="av-bg" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#172237" />
          <stop offset="1" stop-color="#0b0f17" />
        </linearGradient>
        <linearGradient id="av-stroke" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#60a5fa" />
          <stop offset="0.55" stop-color="#3b82f6" />
          <stop offset="1" stop-color="#f97316" />
        </linearGradient>
        <radialGradient id="av-glow" cx="0.3" cy="0.2" r="0.9">
          <stop offset="0" stop-color="#3b82f6" stop-opacity="0.35" />
          <stop offset="1" stop-color="#3b82f6" stop-opacity="0" />
        </radialGradient>
        <pattern id="av-grid" width="10" height="10" patternUnits="userSpaceOnUse">
          <circle cx="1" cy="1" r="0.9" fill="#94a3b8" fill-opacity="0.12" />
        </pattern>
      </defs>
      <rect width="200" height="200" fill="url(#av-bg)" />
      <rect width="200" height="200" fill="url(#av-grid)" />
      <rect width="200" height="200" fill="url(#av-glow)" />
      <path d="M100 30 160.6 65v70L100 170l-60.6-35V65z" fill="none" stroke="url(#av-stroke)" stroke-width="3" stroke-linejoin="round" />
      <path d="M100 48 145 74v52l-45 26-45-26V74z" fill="none" stroke="#3b82f6" stroke-opacity="0.18" stroke-width="1.5" />
      <text x="100" y="116" text-anchor="middle" font-family="Plus Jakarta Sans, sans-serif" font-weight="800" font-size="46" letter-spacing="-1.5" fill="#f1f5f9">{profil.initialen}</text>
      <circle cx="141" cy="100" r="4.5" fill="#f97316" />
    </svg>
  )
}

<style>
  .avatar {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }
</style>
