---
import type { GetStaticPaths } from 'astro';
import ProjectPage from '../../../views/ProjectPage.astro';
import { projekte, slug } from '../../../lib/inhalte';

export const getStaticPaths = (async () =>
  (await projekte('en')).map((projekt) => ({ params: { slug: slug(projekt.id) }, props: { projekt } }))) satisfies GetStaticPaths;

const { projekt } = Astro.props;
---
<ProjectPage lang="en" projekt={projekt} />
